# Secrets are left empty here and generated on first ./install.sh (chmod 600).
# Admin password, JWT secret and gateway key live in niyan.yaml (niyan secrets show).
NIYAN_ADMIN_USERNAME=admin
# Compose project (scopes containers, images and volumes). Installs from before
# this key existed keep running as `niyan` (see README "Updating").
NIYAN_COMPOSE_PROJECT=niyan
OLLAMA_HOST=http://ollama:11434
POSTGRES_USER=niyan
POSTGRES_PASSWORD=
POSTGRES_DB=langfuse
LANGFUSE_PORT=3100
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
GUARDRAILS_PROVIDER=llm_guard
QDRANT_PORT=6333
POSTGRES_VECTOR_DB=niyan_vectors
